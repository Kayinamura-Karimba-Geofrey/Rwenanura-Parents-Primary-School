# nginx reverse proxy for RPPS with HTTPS.
#
# 1. Replace rwenanuraparents.sch.rw with your domain.
# 2. Get a certificate:  certbot --nginx -d rwenanuraparents.sch.rw
# 3. In /srv/rpps/.env set:  TRUST_PROXY=1  APP_URL=https://rwenanuraparents.sch.rw
# 4. nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name rwenanuraparents.sch.rw;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name rwenanuraparents.sch.rw;

    ssl_certificate     /etc/letsencrypt/live/rwenanuraparents.sch.rw/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rwenanuraparents.sch.rw/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The API rejects bodies over 16 KB anyway
    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml text/plain;

    # Live alumni chat (Server-Sent Events): no buffering, long-lived connection
    location = /api/alumni/stream {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
