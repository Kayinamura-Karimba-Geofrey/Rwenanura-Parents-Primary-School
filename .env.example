PORT=5000
# REQUIRED: 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
NODE_ENV=development

# Optional: seed the first admin account (password printed to console if omitted)
SEED_ADMIN_EMAIL=admin@rwenanura.ac.rw
SEED_ADMIN_PASSWORD=

# Set to the number of reverse-proxy hops (e.g. 1 behind nginx) so rate limits
# see real client IPs. Leave empty when the server is exposed directly.
TRUST_PROXY=
# Comma-separated list of origins allowed to call the API cross-origin
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
