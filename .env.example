PORT=5000
# REQUIRED: 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
NODE_ENV=development

# Optional: seed the first admin account. If SEED_ADMIN_PASSWORD is empty a random
# password is written to server/data/initial-admin-password.txt (never logged).
SEED_ADMIN_EMAIL=admin@rwenanura.ac.rw
SEED_ADMIN_PASSWORD=

# Set to the number of reverse-proxy hops (e.g. 1 behind nginx) so rate limits
# see real client IPs. Leave empty when the server is exposed directly.
TRUST_PROXY=
# Comma-separated list of origins allowed to call the API cross-origin
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Public URL of the site, used in links inside emails (verification, password reset)
APP_URL=http://localhost:5173
# Outgoing email. Leave SMTP_HOST empty in development: emails are printed to
# the server console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rwenanura Parents Primary School <no-reply@rwenanura.ac.rw>
# Optional: address that receives an email for every new admission application
ADMISSIONS_NOTIFY_EMAIL=
